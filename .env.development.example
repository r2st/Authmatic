# Development environment (ticket 0019). Copy to .env for local dev.
# Demo shortcuts are allowed here; they are REFUSED in production.
AUTHMATIC_ENV=development

# Local Postgres (infra/docker-compose.local.yml) or an InsForge dev project.
INSFORGE_DB_URL=postgres://authmatic:authmatic@localhost:55432/authmatic
INSFORGE_PROJECT_URL=
INSFORGE_API_KEY=

# Auth (dev fallback secret is used if unset — NEVER do that in prod).
SESSION_SECRET=
AGENT_SERVICE_TOKEN=

# Demo conveniences — only legitimate in non-prod.
DEMO_FIXTURE_MODE=true
USE_INPROCESS_AGENT=true

# Sponsors may be left blank in fixture mode.
DAYTONA_API_KEY=
RTRVR_API_KEY=
OPSERA_TOKEN=
OPENROUTER_API_KEY=
LOG_LEVEL=debug

# Canonical agent routing (ticket 0025): true → /api/run + /api/stream proxy
# to the Python agent (apps/agent). Off in dev demo; MUST be true in prod.
USE_PYTHON_AGENT=false
RTRVR_TIMEOUT_MS=15000
