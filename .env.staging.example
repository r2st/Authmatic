# Staging environment (ticket 0019). Mirrors production config; real services.
AUTHMATIC_ENV=staging

INSFORGE_DB_URL=            # staging InsForge Postgres URL (required)
INSFORGE_PROJECT_URL=       # required
INSFORGE_API_KEY=           # required (from secrets store, ticket 0023)

SESSION_SECRET=             # required, >=16 chars (openssl rand -base64 32)
AGENT_SERVICE_TOKEN=        # required (openssl rand -base64 32)

# No demo shortcuts in staging — exercise the real path.
DEMO_FIXTURE_MODE=false
USE_INPROCESS_AGENT=false

DAYTONA_API_KEY=            # required
RTRVR_API_KEY=              # required
OPSERA_TOKEN=               # required
OPENROUTER_API_KEY=         # required
TIGRIS_* =                  # required for chart storage
LOG_LEVEL=info
SENTRY_DSN=                 # recommended (ticket 0011)

USE_PYTHON_AGENT=true   # canonical Python agent (ticket 0025)
RTRVR_TIMEOUT_MS=15000
