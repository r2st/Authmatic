# Production environment (ticket 0019). All secrets come from the vault
# (ticket 0023), NOT a committed file. The agent REFUSES to boot if a demo
# shortcut is enabled here (assert_safe_for_production).
AUTHMATIC_ENV=production

INSFORGE_DB_URL=            # REQUIRED — prod InsForge Postgres
INSFORGE_PROJECT_URL=       # REQUIRED
INSFORGE_API_KEY=           # REQUIRED (vault)

SESSION_SECRET=             # REQUIRED, >=16 chars (vault) — app refuses to boot without it
AGENT_SERVICE_TOKEN=        # REQUIRED (vault) — agent fails closed without it

# MUST be false in production (startup assert enforces this).
DEMO_FIXTURE_MODE=false
USE_INPROCESS_AGENT=false

DAYTONA_API_KEY=            # REQUIRED (vault)
RTRVR_API_KEY=              # REQUIRED (vault)
OPSERA_TOKEN=               # REQUIRED (vault)
OPENROUTER_API_KEY=         # REQUIRED (vault)
TIGRIS_* =                  # REQUIRED (vault) — SSE-KMS + versioning on (ADR 0008)
LOG_LEVEL=info
SENTRY_DSN=                 # REQUIRED (ticket 0011)

USE_PYTHON_AGENT=true   # REQUIRED true in prod — scripted orchestrator is disabled (ticket 0025/0019)
RTRVR_TIMEOUT_MS=15000
